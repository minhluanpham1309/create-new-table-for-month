# Environment Variables for MoveDataToMysql Lambda Function

# AWS Configuration
AWS_REGION=ap-northeast-1

# RDS MySQL Configuration
RDS_SECRET_NAME=rds/db-test-private
RDS_CA_BUNDLE_PATH=/var/task/rds-ca-bundle.pem

# Redis Valkey Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_SSL=false
# REDIS_PASSWORD=your-redis-password  # Uncomment if authentication is enabled

# Optional: Custom Configuration
# REDIS_KEY_PATTERN=myapp:*
